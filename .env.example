# GEMINI_API_KEY: Required for the AI Assistant chat (streaming) and AI Reports.
# Get a free key at https://aistudio.google.com/apikey, paste it below, and restart
# the server with `npm run dev`. Without it the assistant reports itself offline and
# only the Invest / Withdraw / Alert commands work.
# NOTE: the literal value "your_key_here" is treated as unset — replace it entirely.
GEMINI_API_KEY="your_key_here"

# Optional: Live news API keys (app falls back to RSS feeds if none are set)
# GNews — free tier at https://gnews.io/ (recommended for India + world headlines)
GNEWS_API_KEY=""

# NewsAPI.org — https://newsapi.org/ (India country=in, world business headlines)
NEWS_API_KEY=""

# Finnhub — real-time quotes + company news (Impact on Stocks pipeline)
FINNHUB_API_KEY=""

# GNews — macro/geopolitical keyword search (Impact on Stocks pipeline)
GNEWS_API_KEY=""

# APP_URL: Public origin of the running server (no trailing slash).
# Required for GitHub Actions to trigger the daily snapshot after deploys/restarts.
# AI Studio / Cloud Run injects this automatically. Local default is http://127.0.0.1:3002
APP_URL="MY_APP_URL"

# SNAPSHOT_JOB_SECRET: Shared secret for POST /api/jobs/daily-snapshot.
# Required in production (GitHub Actions sends it as x-snapshot-job-secret).
# If unset, only loopback callers are accepted.
SNAPSHOT_JOB_SECRET=""

# SNAPSHOT_ALERT_WEBHOOK: Optional. There is no Slack/email channel in this repo.
# If set, failed/unrecoverable snapshot runs POST a JSON payload here after retries.
# Leave blank to rely on [SNAPSHOT_ALERT] error logs + /api/health + the dashboard badge.
SNAPSHOT_ALERT_WEBHOOK=""

# SNAPSHOT_RETRY_DELAYS_MS: Backoff between the 3 snapshot attempts (default = 2m, 5m, 10m).
# SNAPSHOT_RETRY_DELAYS_MS="120000,300000,600000"
